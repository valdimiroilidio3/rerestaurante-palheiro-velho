# ————————————————————————————————————————————————————————————
# Base de dados do site (Supabase)
# Copiar para .env.local e preencher. Sem estas variáveis o site
# funciona com o conteúdo de origem.
#
# Onde encontrar: supabase.com → projeto → Project Settings → API
# ————————————————————————————————————————————————————————————

# URL do projeto (ex.: https://abcdefghijklmno.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" — é segura de usar no browser porque quem a
# tem só consegue ler: escrever exige o token de acesso (ver abaixo).
VITE_SUPABASE_ANON_KEY=

# ————————————————————————————————————————————————————————————
# Acesso único ao painel
#
# Há um único utilizador e uma única palavra-passe. Não é possível
# criar contas nem recuperar a palavra-passe por email.
# A palavra-passe NÃO é escrita aqui: define-se com
#
#   node scripts/set-admin-password.mjs <utilizador> <palavra-passe> --write
#
# que guarda apenas o sal e o resumo do token derivado.
# ————————————————————————————————————————————————————————————

VITE_ADMIN_SALT=
VITE_ADMIN_TOKEN_HASH=

# ————————————————————————————————————————————————————————————
# Endereço público do site (SEO)
#
# Define o canonical, o og:url e o endereço dentro do sitemap.xml
# e do robots.txt (gerados no build). Sem esta variável, esses
# ficheiros saem com um endereço de exemplo.
# ————————————————————————————————————————————————————————————

VITE_SITE_URL=

# ————————————————————————————————————————————————————————————
# Fotografias (opcional)
#
# Com VITE_SUPABASE_TRANSFORM=1 as fotos enviadas pelo painel são
# servidas em várias larguras pelo Storage (reduções de imagem).
# Só funciona em planos com transformações ativas; sem isto serve-se
# o ficheiro original, que já vai comprimido (máx. 1800 px, webp).
# ————————————————————————————————————————————————————————————

VITE_SUPABASE_TRANSFORM=0

# ————————————————————————————————————————————————————————————
# Medição de audiência (opcional)
#
# Sem estas duas variáveis o site não carrega analytics nenhum,
# mesmo que o visitante aceite cookies. Com elas, a medição só
# entra depois do consentimento — e sai se ele for retirado.
# Exemplo: Plausible (VITE_ANALYTICS_SRC=https://plausible.io/js/script.js)
# ————————————————————————————————————————————————————————————

VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
