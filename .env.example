# ————————————————————————————————————————————————————————————
# Base de dados do site (Supabase)
# Copiar para .env.local e preencher. Sem estas variáveis o site
# funciona com o conteúdo de origem e o painel mostra o ecrã de
# configuração.
#
# Onde encontrar: supabase.com → projeto → Project Settings → API
# ————————————————————————————————————————————————————————————

# URL do projeto (ex.: https://abcdefghijklmno.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" — é segura de usar no browser porque a
# segurança é feita pelas políticas RLS (ver supabase/migrations).
VITE_SUPABASE_ANON_KEY=
