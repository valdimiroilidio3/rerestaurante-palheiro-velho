{
  "name": "palheiro-velho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conceito de website para o Palheiro Velho, bar de praia em Esmoriz (Ovar, Portugal).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site && npm run build:admin",
    "preview": "vite preview",
    "typecheck": "tsc --build --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && vite build",
    "build:site": "npm run typecheck && vite build",
    "build:admin": "vite build --config vite.admin.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "db:check": "node scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "2.1.1",
    "framer-motion": "^13.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.46.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
